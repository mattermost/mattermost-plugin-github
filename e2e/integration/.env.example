# Copy to .env. docker compose and the tests both read it.
# Values for the real lane live in 1Password (search "GitHub plugin E2E"); never paste them into chats, issues or PRs.

# Stack (optional). Defaults avoid the ports other plugin E2E stacks use.
# MM_PORT=8069
# PW_BROWSER_PORT=3336
# MM_IMAGE=mattermostdevelopment/mattermost-enterprise-edition:master

# Real lane only (npm run test:real). The PR lane needs none of these.
# A classic OAuth app whose callback URL is http://127.0.0.1:${MM_PORT}/plugins/github/oauth/complete
E2E_GITHUB_OAUTH_CLIENT_ID=
E2E_GITHUB_OAUTH_CLIENT_SECRET=
# owner/name of a throwaway repository in a test organization. The machine account needs admin on it.
E2E_GITHUB_REPO=
# OAuth token (or classic personal access token) of the machine account.
# Scopes: repo, notifications, read:org, admin:org_hook, admin:repo_hook
E2E_GITHUB_MACHINE_TOKEN=

# Optional: the real sign-in test skips without these. The account needs 2FA with an authenticator app.
E2E_GITHUB_LOGIN_USERNAME=
E2E_GITHUB_LOGIN_PASSWORD=
E2E_GITHUB_LOGIN_TOTP_SECRET=
